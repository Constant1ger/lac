fakeMain(A$iLstS):u{@A.sz}
prAll = (iLstS){prln(.)} // если получаемый объект функции иммутабелен то явно указывать & нет необходимости.

main(A) {  // main может указывать только название массива аргументов
  B=A.flt{.sz<4}{.upc}.iLstS /*.flt - фильтрация по переданному предикату , .sz - string size , .up = .toUpperCase() , точка между цепочками функций над потоком не нужна "}{" понимается как "}.map{", тип коллекции определяем как постфикс типа, т.е. iList<Sting> это iLst<S> это iLstS */
  B.{.prln}	// сделаем как в D pr(a) это тоже самое что a.pr
  prAll(A)
  str = A.sz==B.sz?"A равно B":"A отличается от B на {A.sz-B.sz}"
  str.prln
  @1		// возвращаем из main единицу
}